{
  "name": "codeatlas-visualizer",
  "displayName": "CodeAtlas Visualizer",
  "description": "Visualize your codebase in VS Code with an interactive dependency graph, file relationship map, module explorer, and project structure analyzer.",
  "version": "0.0.6",
  "publisher": "mrRoy",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrroy01-bit/codebase-visualizer.git"
  },
  "homepage": "https://github.com/mrroy01-bit/codebase-visualizer",
  "bugs": {
    "url": "https://github.com/mrroy01-bit/codebase-visualizer/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:codebaseVisualizer.show",
    "onCommand:codebaseVisualizer.refresh"
  ],
  "main": "./Extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebaseVisualizer.show",
        "title": "Open Project Graph",
        "category": "CodeAtlas"
      },
      {
        "command": "codebaseVisualizer.refresh",
        "title": "Refresh Project Graph",
        "category": "CodeAtlas"
      }
    ],
    "configuration": {
      "title": "CodeAtlas",
      "properties": {
        "codebaseVisualizer.excludePatterns": {
          "type": "array",
          "default": [
            "venv",
            ".venv",
            "node_modules",
            "__pycache__",
            ".git",
            "dist",
            "build",
            ".next",
            "coverage"
          ],
          "items": {
            "type": "string"
          },
          "description": "Folder or file patterns to skip during analysis."
        },
        "codebaseVisualizer.maxFiles": {
          "type": "number",
          "default": 750,
          "minimum": 50,
          "description": "Maximum number of files to analyze before stopping the scan."
        },
        "codebaseVisualizer.includeExtensions": {
          "type": "array",
          "default": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".py",
            ".vue",
            ".svelte"
          ],
          "items": {
            "type": "string"
          },
          "description": "File extensions that should be included in the graph."
        }
      }
    }
  },
  "scripts": {
    "lint": "node -e \"console.log('No lint step configured yet.')\"",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish": "npx @vscode/vsce publish --no-dependencies"
  },
  "keywords": [
    "graph",
    "dependency",
    "visualizer",
    "architecture",
    "workspace",
    "codebase",
    "dependency graph",
    "file dependencies",
    "project structure",
    "import graph",
    "module graph",
    "software architecture",
    "code visualization",
    "typescript",
    "javascript",
    "python",
    "developer tools",
    "explorer"
  ],
  "license": "MIT",
  "preview": true,
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
